@model IEnumerable<DSWI_T1_05.DTOs.CitaDto>

@{
    ViewData["Title"] = "Listado de Citas";
}

<h2>Listado de Citas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nueva Cita
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Especialidad</th>
            <th>Estado</th>
            <th>Paciente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cita in Model)
        {
            <tr>
                <td>@cita.CitaId</td>
                <td>@cita.Fecha?.ToString("dd/MM/yyyy")</td>
                <td>@cita.Hora?.ToString("HH:mm")</td>
                <td>@cita.Especialidad</td>
                <td>@cita.Estado</td>
                <td>@cita.NombrePaciente</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@cita.CitaId"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
