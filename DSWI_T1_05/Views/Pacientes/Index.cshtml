
@model IEnumerable<DSWI_T1_05.DTOs.PacienteDto>

@{
    ViewData["Title"] = "Listado de Pacientes";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Listado de Pacientes</h2>
            <p class="text-muted">Administración de pacientes de la clínica</p>
        </div>

        <a asp-controller="Pacientes"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Paciente
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>DNI</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var paciente in Model)
                        {
                            <tr>
                                <td>@paciente.PacienteId</td>
                                <td>@paciente.Nombre</td>
                                <td>@paciente.Dni</td>
                                <td class="text-center">
                                    <a asp-controller="Pacientes"
                                       asp-action="Edit"
                                       asp-route-id="@paciente.PacienteId"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No hay pacientes registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
