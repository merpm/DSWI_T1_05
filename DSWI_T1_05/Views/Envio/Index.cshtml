
@model DSWI_T1_05.Models.ViewModels.Envio.CalcularEnvioViewModel

@{
    ViewData["Title"] = "Cálculo de Envío";
    decimal recargo = Model.Internacional ? 15m : 0m;
}

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f5f6f8;
    }

    .formulario-envio {
        width: 100%;
        max-width: 370px;
        margin: 30px auto 25px 8%;
        padding: 20px;
        background: white;
        border: 1px solid #dce1e6;
        border-radius: 7px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        box-sizing: border-box;
    }

        .formulario-envio h2 {
            font-size: 19px;
            color: #263b53;
            margin: 0 0 7px;
            text-align: center;
        }

    .descripcion {
        text-align: center;
        color: #777;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .campo {
        margin-bottom: 14px;
    }

        .campo label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 6px;
            color: #333;
        }

        .campo input,
        .campo select {
            width: 100%;
            height: 36px;
            padding: 7px 9px;
            border: 1px solid #cbd2da;
            border-radius: 5px;
            background: white;
            font-size: 13px;
            box-sizing: border-box;
        }

            .campo input:focus,
            .campo select:focus {
                outline: none;
                border-color: #376990;
            }

    .boton-envio {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 5px;
        background: #32658b;
        color: white;
        font-size: 13px;
        cursor: pointer;
    }

        .boton-envio:hover {
            background: #244c6c;
        }

    .resultado-envio {
        margin-top: 20px;
        border-top: 1px solid #e1e5e9;
        padding-top: 15px;
        font-size: 13px;
    }

        .resultado-envio h3 {
            font-size: 15px;
            color: #263b53;
            margin: 0 0 15px;
        }

    .fila-resultado {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .total-envio {
        margin-top: 13px;
        padding-top: 12px;
        border-top: 1px solid #ddd;
        font-size: 16px;
        font-weight: bold;
        color: #246044;
    }

    .error-envio {
        color: #b42318;
        font-size: 12px;
    }

    @@media (max-width: 600px) {
        .formulario-envio {
            margin: 20px auto;
        }
    }
</style>

<div class="formulario-envio">

    <h2>Cálculo de Envío</h2>

    <form asp-controller="Envio"
          asp-action="Index"
          method="post">

        <div class="campo">
            <label asp-for="Peso">
                Peso del paquete (kg)
            </label>

            <input asp-for="Peso"
                   type="number"
                   step="0.01"
                   min="0.01"
                   required />

            <span asp-validation-for="Peso"
                  class="error-envio"></span>
        </div>

        <div class="campo">
            <label asp-for="Internacional">
                Tipo de envío
            </label>

            <select asp-for="Internacional">
                <option value="false">Nacional</option>
                <option value="true">Internacional</option>
            </select>
        </div>

        <button type="submit" class="boton-envio">
            Calcular Envío
        </button>

    </form>

    @if (ViewBag.Resultado == true)
    {
    <div class="resultado-envio">

        <h3>Detalle del envío</h3>

        <div class="fila-resultado">
            <span>Peso:</span>
            <strong>@Model.Peso.ToString("N2") kg</strong>
        </div>

        <div class="fila-resultado">
            <span>Precio por kilo:</span>
            <strong>$ @Model.PrecioKilo.ToString("N2")</strong>
        </div>

        <div class="fila-resultado">
            <span>Tipo de envío:</span>
            <strong>
                @(Model.Internacional ? "Internacional" : "Nacional")
            </strong>
        </div>

        <div class="fila-resultado">
            <span>Recargo:</span>
            <strong>$ @recargo.ToString("N2")</strong>
        </div>

        <div class="fila-resultado total-envio">
            <span>Total a pagar:</span>
            <span>$ @Model.Total.ToString("N2")</span>
        </div>

    </div>
    }

</div>
